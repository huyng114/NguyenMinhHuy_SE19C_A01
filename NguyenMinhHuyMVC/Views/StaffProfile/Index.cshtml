@model StaffProfileViewModel
@{
    ViewData["Title"] = "My profile";
}
<div class="page-header">
    <div><p class="page-kicker">Your account</p><h1 class="page-title">My profile</h1><p class="page-description">Update your name or email. Leave the new password blank to keep your current password.</p></div>
</div>
<div class="reading-column">
        <form asp-action="Index" method="post" class="surface-card">
            <div class="card-body p-4">
                <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                <p class="form-note">Fields marked <span class="required-indicator" aria-hidden="true">*</span> are required.</p>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label">Name <span class="required-indicator" aria-hidden="true">*</span></label>
                    <input asp-for="Name" class="form-control" autocomplete="name" aria-required="true" aria-describedby="profileNameError" />
                    <span asp-validation-for="Name" id="profileNameError" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label">Email <span class="required-indicator" aria-hidden="true">*</span></label>
                    <input asp-for="Email" class="form-control" autocomplete="email" aria-required="true" aria-describedby="profileEmailError" />
                    <span asp-validation-for="Email" id="profileEmailError" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="CurrentPassword" class="form-label">Current password <span class="required-indicator" aria-hidden="true">*</span></label>
                    <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" aria-required="true" aria-describedby="profileCurrentPasswordError" />
                    <span asp-validation-for="CurrentPassword" id="profileCurrentPasswordError" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="NewPassword" class="form-label"></label>
                    <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-describedby="profileNewPasswordError" />
                    <span asp-validation-for="NewPassword" id="profileNewPasswordError" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="ConfirmNewPassword" class="form-label"></label>
                    <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" aria-describedby="profileConfirmPasswordError" />
                    <span asp-validation-for="ConfirmNewPassword" id="profileConfirmPasswordError" class="text-danger"></span>
                </div>
                <p class="form-text mb-3">You will sign in again after saving your profile.</p>
                <button type="submit" class="btn btn-primary">Save profile</button>
            </div>
        </form>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
