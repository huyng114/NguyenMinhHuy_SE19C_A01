@model CategoryListViewModel
@{
    ViewData["Title"] = "Category management";
}
<div class="page-header">
    <div>
        <p class="page-kicker">Content library</p>
        <h1 class="page-title">Category management</h1>
        <p class="page-description">Organize news with categories and parent categories.</p>
    </div>
    <div class="page-actions"><button type="button" class="btn btn-primary" data-category-form="@Url.Action("Create")">Create category</button></div>
</div>
@if (TempData["Success"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
<form asp-action="Index" method="get" class="filter-panel">
  <div class="row g-3 align-items-end">
    <div class="col-md-6">
        <label asp-for="Search" class="form-label">Name or description</label>
        <input asp-for="Search" class="form-control" placeholder="Search categories" />
    </div>
    <div class="col-md-3">
        <label asp-for="IsActive" class="form-label">Status</label>
        <select asp-for="IsActive" class="form-select">
            <option value="">All statuses</option>
            <option value="true">Active</option>
            <option value="false">Inactive</option>
        </select>
    </div>
    <div class="col-md-3 filter-actions">
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</div>
</form>
<section class="data-panel" aria-label="Category results">
  <div class="data-panel-header"><h2>Categories</h2><p class="result-count" role="status">@Model.Categories.Count @(Model.Categories.Count == 1 ? "category" : "categories") found</p></div>
  @if (Model.Categories.Count == 0)
  {
    <div class="empty-state">
        @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.IsActive.HasValue)
        {
            <strong>No categories match your filters.</strong><span>Try another name or status, or <a asp-action="Index">clear the filters</a>.</span>
        }
        else
        {
            <strong>No categories yet.</strong><span>Use Create category to organize news articles.</span>
        }
    </div>
  }
  else
  {
  <p class="table-scroll-hint">Scroll the table horizontally to see all columns and actions.</p>
  <div class="table-responsive" tabindex="0" role="region" aria-label="Categories table">
    <table class="table table-hover align-middle data-table">
        <caption class="visually-hidden">News categories</caption>
        <thead>
            <tr><th scope="col">ID</th><th scope="col">Name</th><th scope="col">Description</th><th scope="col">Parent</th><th scope="col">Status</th><th scope="col" class="text-end">Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var category in Model.Categories)
            {
                <tr>
                    <td>@category.Id</td>
                    <td class="text-break">@category.Name</td>
                    <td class="text-break">@category.Description</td>
                    <td class="text-break">@(category.ParentName ?? "None")</td>
                    <td><span class="status-badge @(category.IsActive == true ? "status-active" : category.IsActive == false ? "status-inactive" : "status-unspecified")">@(category.IsActive == true ? "Active" : category.IsActive == false ? "Inactive" : "Unspecified")</span></td>
                    <td class="text-end text-nowrap"><div class="table-actions">
                        <button type="button" class="btn btn-sm btn-outline-primary" data-category-form="@Url.Action("Edit", new { id = category.Id })" aria-label="Edit @category.Name">Edit</button>
                        <button type="button" class="btn btn-sm btn-outline-danger ms-1" data-bs-toggle="modal" data-bs-target="#deleteCategoryModal"
                                data-category-id="@category.Id" data-category-name="@category.Name" aria-label="Delete @category.Name">Delete</button></div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
  </div>
  }
</section>
<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" id="categoryModalContent"></div>
    </div>
</div>
<div class="modal fade" id="deleteCategoryModal" tabindex="-1" aria-labelledby="deleteCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-action="Delete" method="post" id="deleteCategoryForm">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="deleteCategoryModalLabel">Delete category</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="deleteCategoryId" />
                    <p>Delete <strong id="deleteCategoryName"></strong>?</p>
                    <p class="text-muted mb-0">This action cannot be undone. Categories used by news articles or containing child categories cannot be deleted.</p>
                    <div id="deleteCategoryError" class="alert alert-danger mt-3 mb-0 d-none" role="alert"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete category</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/categories.js" asp-append-version="true"></script>
}
