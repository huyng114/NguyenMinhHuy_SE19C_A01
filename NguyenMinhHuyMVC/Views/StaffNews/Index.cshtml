@model NewsListViewModel
@{
    ViewData["Title"] = "News management";
}
<div class="page-header">
    <div><p class="page-kicker">Editorial desk</p><h1 class="page-title">News management</h1><p class="page-description">Manage articles, categories and article tags.</p></div>
    <div class="page-actions"><button type="button" class="btn btn-primary" data-news-form="@Url.Action("Create")">Create article</button></div>
</div>
@if (TempData["Success"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
<form asp-action="Index" method="get" class="filter-panel">
  <div class="row g-3 align-items-end">
    <div class="col-md-4">
        <label asp-for="Search" class="form-label">Title, headline, content or tag</label>
        <input asp-for="Search" class="form-control" placeholder="Search articles" />
    </div>
    <div class="col-md-3">
        <label asp-for="CategoryId" class="form-label">Category</label>
        <select asp-for="CategoryId" class="form-select">
            <option value="">All categories</option>
            @foreach (var category in Model.Categories)
            {
                <option value="@category.Id">@category.Name</option>
            }
        </select>
    </div>
    <div class="col-md-2">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select"><option value="">All statuses</option><option value="true">Active</option><option value="false">Inactive</option></select>
    </div>
    <div class="col-md-3 filter-actions">
        <button type="submit" class="btn btn-primary">Search</button><a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</div>
</form>
<section class="data-panel" aria-label="Article results">
  <div class="data-panel-header"><h2>Articles</h2><p class="result-count" role="status">@Model.Articles.Count @(Model.Articles.Count == 1 ? "article" : "articles") found</p></div>
  @if (Model.Articles.Count == 0)
  {
    <div class="empty-state">
        @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.CategoryId.HasValue || Model.Status.HasValue)
        {
            <strong>No articles match your filters.</strong><span>Try another keyword, category or status, or <a asp-action="Index">clear the filters</a>.</span>
        }
        else
        {
            <strong>No articles yet.</strong><span>Use Create article to publish your first news item.</span>
        }
    </div>
  }
  else
  {
  <p class="table-scroll-hint">Scroll the table horizontally to see all columns and actions.</p>
  <div class="table-responsive" tabindex="0" role="region" aria-label="Articles table">
    <table class="table table-hover align-middle data-table">
        <caption class="visually-hidden">Managed news articles</caption>
        <thead><tr><th scope="col">Article</th><th scope="col">Category / Tags</th><th scope="col">Status</th><th scope="col">Created</th><th scope="col" class="text-end">Actions</th></tr></thead>
        <tbody>
            @foreach (var article in Model.Articles)
            {
                <tr>
                    <td class="text-break"><a asp-action="Details" asp-route-id="@article.Id" class="row-title">@(article.Title ?? article.Headline)</a><div class="small text-muted">@article.Headline</div></td>
                    <td class="text-break">
                        <div>@(article.CategoryName ?? "No category")</div>
                        @foreach (var tag in article.Tags) { <span class="tag-badge">@tag.Name</span> }
                    </td>
                    <td><span class="status-badge @(article.Status == true ? "status-active" : article.Status == false ? "status-inactive" : "status-unspecified")">@(article.Status == true ? "Active" : article.Status == false ? "Inactive" : "Unspecified")</span></td>
                    <td><div>@(article.CreatedDate?.ToString("dd/MM/yyyy HH:mm") ?? "Unknown")</div><div class="small text-muted">@(article.CreatedByName ?? "Unknown author")</div></td>
                    <td class="text-end text-nowrap"><div class="table-actions">
                        <button type="button" class="btn btn-sm btn-outline-primary" data-news-form="@Url.Action("Edit", new { id = article.Id })" aria-label="Edit @(article.Title ?? article.Headline)">Edit</button>
                        <button type="button" class="btn btn-sm btn-outline-danger ms-1" data-bs-toggle="modal" data-bs-target="#deleteNewsModal"
                                data-news-id="@article.Id" data-news-name="@(article.Title ?? article.Headline)" aria-label="Delete @(article.Title ?? article.Headline)">Delete</button></div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
  </div>
  }
</section>
<div class="modal fade" id="newsModal" tabindex="-1" aria-labelledby="newsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable"><div class="modal-content" id="newsModalContent"></div></div>
</div>
<div class="modal fade" id="deleteNewsModal" tabindex="-1" aria-labelledby="deleteNewsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-action="Delete" method="post" id="deleteNewsForm">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="deleteNewsModalLabel">Delete article</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="deleteNewsId" />
                    <p>Delete <strong id="deleteNewsName"></strong>?</p>
                    <p class="text-muted mb-0">This article will be permanently deleted.</p>
                    <div id="deleteNewsError" class="alert alert-danger mt-3 mb-0 d-none" role="alert"></div>
                </div>
                <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-danger">Delete article</button></div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/staff-news.js" asp-append-version="true"></script>
}
