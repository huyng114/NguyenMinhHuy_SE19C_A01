@model AccountFormViewModel
@{
    var isEdit = Model.Id.HasValue;
}
<form asp-controller="AdminAccounts" asp-action="@(isEdit ? "Edit" : "Create")" method="post" id="accountForm" class="d-flex flex-column overflow-hidden">
    <div class="modal-header">
        <h2 class="modal-title h5" id="accountModalLabel">@(isEdit ? "Edit account" : "Create account")</h2>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>
    <div class="modal-body">
        <p class="form-note">Fields marked <span class="required-indicator" aria-hidden="true">*</span> are required.</p>
        @if (isEdit)
        {
            <input asp-for="Id" type="hidden" />
            <p class="small text-muted">Account #@Model.Id</p>
        }
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div id="accountFormError" class="alert alert-danger d-none" role="alert"></div>
        <div class="mb-3">
            <label asp-for="Name" class="form-label">Name <span class="required-indicator" aria-hidden="true">*</span></label>
            <input asp-for="Name" class="form-control" autocomplete="name" aria-required="true" aria-describedby="accountNameError" />
            <span asp-validation-for="Name" id="accountNameError" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Email" class="form-label">Email <span class="required-indicator" aria-hidden="true">*</span></label>
            <input asp-for="Email" class="form-control" autocomplete="off" aria-required="true" aria-describedby="accountEmailError" />
            <span asp-validation-for="Email" id="accountEmailError" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Role" class="form-label">Role <span class="required-indicator" aria-hidden="true">*</span></label>
            <select asp-for="Role" class="form-select" aria-required="true" aria-describedby="accountRoleError">
                <option value="1">Staff</option>
                <option value="2">Lecturer</option>
            </select>
            <span asp-validation-for="Role" id="accountRoleError" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Password" class="form-label">@(isEdit ? "New password (optional)" : "Password") @if (!isEdit) { <span class="required-indicator" aria-hidden="true">*</span> }</label>
            <input asp-for="Password" class="form-control" autocomplete="new-password" aria-required="@(isEdit ? "false" : "true")" aria-describedby="passwordHelp accountPasswordError"
                   required="@(!isEdit)" />
            <span asp-validation-for="Password" id="accountPasswordError" class="text-danger"></span>
            <div id="passwordHelp" class="form-text">@(isEdit ? "Leave blank to keep the current password." : "Enter a password for the new account.")</div>
        </div>
    </div>
    <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
        <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Create account")</button>
    </div>
</form>
