@model AccountListViewModel
@{
    ViewData["Title"] = "Account management";
}
<div class="page-header">
    <div>
        <p class="page-kicker">Administration</p>
        <h1 class="page-title">Account management</h1>
        <p class="page-description">Manage Staff and Lecturer accounts.</p>
    </div>
    <div class="page-actions"><button type="button" class="btn btn-primary" data-account-form="@Url.Action("Create")">Create account</button></div>
</div>
@if (TempData["Success"] is string message)
{
    <div class="alert alert-success" role="status">@message</div>
}
<form asp-action="Index" method="get" class="filter-panel">
  <div class="row g-3 align-items-end">
    <div class="col-md-6">
        <label asp-for="Search" class="form-label">Name or email</label>
        <input asp-for="Search" class="form-control" placeholder="Search accounts" />
    </div>
    <div class="col-md-3">
        <label asp-for="Role" class="form-label"></label>
        <select asp-for="Role" class="form-select">
            <option value="">All roles</option>
            <option value="1">Staff</option>
            <option value="2">Lecturer</option>
        </select>
    </div>
    <div class="col-md-3 filter-actions">
        <button class="btn btn-primary" type="submit">Search</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Clear</a>
    </div>
</div>
</form>
<section class="data-panel" aria-label="Account results">
  <div class="data-panel-header"><h2>Accounts</h2><p class="result-count" role="status">@Model.Accounts.Count @(Model.Accounts.Count == 1 ? "account" : "accounts") found</p></div>
  @if (Model.Accounts.Count == 0)
  {
    <div class="empty-state">
        @if (!string.IsNullOrWhiteSpace(Model.Search) || Model.Role.HasValue)
        {
            <strong>No accounts match your filters.</strong><span>Try another name, email or role, or <a asp-action="Index">clear the filters</a>.</span>
        }
        else
        {
            <strong>No accounts yet.</strong><span>Use Create account to add a Staff or Lecturer account.</span>
        }
    </div>
  }
  else
  {
  <p class="table-scroll-hint">Scroll the table horizontally to see all columns and actions.</p>
  <div class="table-responsive" tabindex="0" role="region" aria-label="Accounts table">
    <table class="table table-hover align-middle data-table">
        <caption class="visually-hidden">Staff and Lecturer accounts</caption>
        <thead>
            <tr><th scope="col">ID</th><th scope="col">Name</th><th scope="col">Email</th><th scope="col">Role</th><th scope="col" class="text-end">Actions</th></tr>
        </thead>
        <tbody>
            @foreach (var account in Model.Accounts)
            {
                <tr>
                    <td>@account.Id</td>
                    <td>@account.Name</td>
                    <td>@account.Email</td>
                    <td>@(BusinessObjects.Security.AccountRoles.FromDatabase(account.Role) ?? "Unknown")</td>
                    <td class="text-end text-nowrap"><div class="table-actions">
                        <button type="button" class="btn btn-sm btn-outline-primary"
                                data-account-form="@Url.Action("Edit", new { id = account.Id })" aria-label="Edit @account.Name">Edit</button>
                        <button type="button" class="btn btn-sm btn-outline-danger ms-1"
                                data-bs-toggle="modal" data-bs-target="#deleteAccountModal"
                                data-account-id="@account.Id" data-account-name="@account.Name" aria-label="Delete @account.Name">Delete</button></div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
  </div>
  }
</section>

<div class="modal fade" id="accountModal" tabindex="-1" aria-labelledby="accountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content" id="accountModalContent"></div>
    </div>
</div>
<div class="modal fade" id="deleteAccountModal" tabindex="-1" aria-labelledby="deleteAccountModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
        <div class="modal-content">
            <form asp-action="Delete" method="post" id="deleteAccountForm">
                <div class="modal-header">
                    <h2 class="modal-title h5" id="deleteAccountModalLabel">Delete account</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="id" id="deleteAccountId" />
                    <p>Delete <strong id="deleteAccountName"></strong>?</p>
                    <p class="text-muted mb-0">This action cannot be undone. Accounts linked to news articles cannot be deleted.</p>
                    <div id="deleteAccountError" class="alert alert-danger mt-3 mb-0 d-none" role="alert"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger">Delete account</button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin-accounts.js" asp-append-version="true"></script>
}
