@model LoginViewModel
@{
    ViewData["Title"] = "Login";
}
<div class="auth-layout">
    <div class="auth-panel">
        <div class="card auth-card">
            <div class="card-body p-4">
                @if (TempData["Success"] is string message)
                {
                    <div class="alert alert-success" role="status">@message</div>
                }
                <p class="page-kicker">Your workspace</p>
                <h1 class="page-title mb-2">Welcome to FU News</h1>
                <p class="page-description mb-4">Sign in to access your account.</p>
                <form asp-controller="Account" asp-action="Login" method="post">
                    <input asp-for="ReturnUrl" type="hidden" />
                    <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
                    <p class="form-note">Email and password are required.</p>
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email <span class="required-indicator" aria-hidden="true">*</span></label>
                        <input asp-for="Email" class="form-control" autocomplete="username" aria-required="true" aria-describedby="loginEmailError" />
                        <span asp-validation-for="Email" id="loginEmailError" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password <span class="required-indicator" aria-hidden="true">*</span></label>
                        <input asp-for="Password" class="form-control" autocomplete="current-password" aria-required="true" aria-describedby="loginPasswordError" />
                        <span asp-validation-for="Password" id="loginPasswordError" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">Login</button>
                </form>
                <a asp-controller="News" asp-action="Index" class="d-block text-center mt-3">Read news as a guest</a>
            </div>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
